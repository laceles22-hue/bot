//@version=5
indicator(title="Williams VIX Fix Oscillator [LW]", shorttitle="LW VIX Fix", overlay=false)

// --- CONFIGURACIÓN ---
vix_len           = input.int(22, title="VIX Fix Periodo Lookback", group="Williams VIX Fix")
vix_bblen         = input.int(20, title="Bandas VIX Periodo", group="Williams VIX Fix")
vix_mult_aviso    = input.float(2.0, title="Umbral Aviso (Desviaciones)", group="Williams VIX Fix")
vix_mult_anomalia = input.float(2.5, title="Umbral Anomalía (Desviaciones)", group="Williams VIX Fix")
show_vix_z_lines  = input.bool(true, title="Mostrar Líneas Umbral (±σ Aviso / ±σ Anomalía)", group="Williams VIX Fix")

show_range_signal = input.bool(true, title="Señalar Velas de Gran Rango (Breakout)", group="Rango / Volatilidad")

dark_panel_bg = input.bool(true, title="Fondo Oscuro del Panel", group="Estilo")

// --- CÁLCULO: WILLIAMS VIX FIX (Suelo de Mercado) ---
highest_close = ta.highest(close, vix_len)
wvf = ((highest_close - low) / highest_close) * 100
vix_basis = ta.sma(wvf, vix_bblen)
vix_stdev = ta.stdev(wvf, vix_bblen)
// Z-score: cuántas desviaciones estándar se aleja el VIX Fix de su media móvil
vix_z = vix_stdev == 0 ? 0.0 : (wvf - vix_basis) / vix_stdev

// --- CÁLCULO: RANGO AMPLIO (LARGE RANGE BAR) ---
atr_val       = ta.atr(14)
is_wide_range = (high - low) > (atr_val * 1.6)

// --- DIBUJO: EL OSCILADOR ES EL HISTOGRAMA VIX FIX ---
// Fondo oscuro fijo del panel, independiente del tema del gráfico de precio
bgcolor(dark_panel_bg ? color.new(#131722, 0) : na, title="Fondo Oscuro del Panel")

// El VIX Fix sube cuando el precio CAE con fuerza (miedo/volatilidad bajista) y
// baja cuando el precio sube tranquilo. Por eso: rojo en zona positiva (caída/miedo),
// azul en zona negativa (calma/subida) — así el color queda alineado con la dirección real del precio.
vix_hist_color = vix_z >= 0 ? color.new(color.red, 30) : color.new(color.blue, 30)
plot(vix_z, title="VIX Fix (z-score)", style=plot.style_area, color=vix_hist_color, linewidth=1)

// Líneas de referencia del umbral (estructura ±σ aviso / ±σ anomalía)
h_vix_zero        = hline(show_vix_z_lines ? 0.0 : na, "VIX Fix Z 0", color=color.new(color.gray, 50), linestyle=hline.style_solid)
h_aviso_pos       = hline(show_vix_z_lines ? vix_mult_aviso : na, "+σ Aviso", color=color.teal, linestyle=hline.style_dotted)
h_aviso_neg       = hline(show_vix_z_lines ? -vix_mult_aviso : na, "−σ Aviso", color=color.teal, linestyle=hline.style_dotted)
h_anomalia_pos    = hline(show_vix_z_lines ? vix_mult_anomalia : na, "+σ Anomalía", color=color.orange, linestyle=hline.style_dotted)
h_anomalia_neg    = hline(show_vix_z_lines ? -vix_mult_anomalia : na, "−σ Anomalía", color=color.orange, linestyle=hline.style_dotted)

// Fondo de alerta VIX Fix (Potencial suelo/rebote agresivo)
is_vix_anomalia = vix_z >= vix_mult_anomalia
is_vix_aviso    = vix_z >= vix_mult_aviso and not is_vix_anomalia
vix_bg_color = is_vix_anomalia ? color.new(color.orange, 70) : is_vix_aviso ? color.new(color.teal, 80) : na
bgcolor(vix_bg_color, title="VIX Fix Alerta Suelo")

// Triángulos de reversión en cruces del umbral de anomalía (±2.5σ)
// Ubicados junto al pico/valle real que dispara la señal, no al lado opuesto del panel.
// Spike de miedo (+anomalía, pico rojo hacia arriba) = capitulación → posible suelo/rebote alcista
plotshape(ta.crossover(vix_z, vix_mult_anomalia), title="Spike de Miedo (posible suelo/rebote)",
          style=shape.triangledown, location=location.top, color=color.green, size=size.small)
// Calma extrema (−anomalía, valle azul hacia abajo) = complacencia → posible techo/agotamiento
plotshape(ta.crossunder(vix_z, -vix_mult_anomalia), title="Complacencia Extrema (posible techo)",
          style=shape.triangleup, location=location.bottom, color=color.red, size=size.small)

plotchar(show_range_signal and is_wide_range, title="Vela Rango Amplio",
         char="⚡", location=location.top, color=color.yellow, size=size.tiny)
