//@version=5
indicator(title="Williams Strategy Toolkit [LW]", shorttitle="LW Toolkit", overlay=false)

// --- CONFIGURACIÓN ---
wr_len            = input.int(14, title="%R Periodo", group="Williams %R")
wr_ob             = input.int(-20, title="%R Sobrecompra", group="Williams %R")
wr_os             = input.int(-80, title="%R Sobreventa", group="Williams %R")

vix_len           = input.int(22, title="VIX Fix Periodo Lookback", group="Williams VIX Fix")
vix_bblen         = input.int(20, title="Bandas VIX Periodo", group="Williams VIX Fix")
vix_mult          = input.float(2.0, title="Bandas VIX Desviación", group="Williams VIX Fix")

show_range_signal = input.bool(true, title="Señalar Velas de Gran Rango (Breakout)", group="Rango / Volatilidad")

// --- CÁLCULO: WILLIAMS %R ---
// ta.wpr previene errores internos por rango cero (high == low)
wpr = ta.wpr(wr_len)

// --- CÁLCULO: WILLIAMS VIX FIX (Suelo de Mercado) ---
highest_close = ta.highest(close, vix_len)
wvf = ((highest_close - low) / highest_close) * 100
vix_basis = ta.sma(wvf, vix_bblen)
vix_dev   = vix_mult * ta.stdev(wvf, vix_bblen)
vix_upper = vix_basis + vix_dev

// --- CÁLCULO: RANGO AMPLIO (LARGE RANGE BAR) ---
atr_val       = ta.atr(14)
is_wide_range = (high - low) > (atr_val * 1.6)

// --- DIBUJO ---
plot(wpr, title="Williams %R", color=color.white, linewidth=2)
h_ob = hline(wr_ob, "Sobrecompra", color=color.red, linestyle=hline.style_dotted)
h_os = hline(wr_os, "Sobreventa", color=color.green, linestyle=hline.style_dotted)
fill(h_ob, h_os, color=color.new(color.blue, 90), title="Zona Neutral")

// Fondo de alerta VIX Fix (Potencial suelo/rebote agresivo)
is_vix_alert = wvf >= vix_upper
bgcolor(is_vix_alert ? color.new(color.teal, 80) : na, title="VIX Fix Alerta Suelo")

// Señales visuales sobre el oscilador
plotshape(is_vix_alert and ta.crossover(wpr, wr_os), title="Rebote Fuerte Confirmado",
          style=shape.triangleup, location=location.bottom, color=color.green, size=size.small)

plotchar(show_range_signal and is_wide_range, title="Vela Rango Amplio",
         char="⚡", location=location.top, color=color.yellow, size=size.tiny)
