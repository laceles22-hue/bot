//@version=6
// =====================================================================
// Niveles Diarios Oro (XAUUSD) — Sesiones, Aperturas y Pivotes
// ---------------------------------------------------------------------
// Pensado para el estilo "niveles relevantes del día" que se enseña en
// muchas academias de trading sobre oro:
//   - Máx/Mín del día y semana anterior  -> resistencia/soporte "mayor"
//   - Apertura diaria y semanal
//   - Rango de la sesión de Asia (Tokio)
//   - Rango de la sesión de Londres + su apertura ("nivel de Londres")
//   - Apertura de Nueva York
//   - Apertura de medianoche NY (00:00 hora de Nueva York, estilo ICT)
//   - Pivotes clásicos de floor trader (PP, R1-R3, S1-S3), en timeframe
//     diario, semanal o mensual a elección
// Todos los niveles se recalculan solos en cada nuevo período; no hace
// falta arrastrar nada manualmente día a día.
// =====================================================================
indicator("Niveles Diarios Oro (XAUUSD)", shorttitle="Niveles Oro", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================= HELPERS =============================
lineStyleFromInput(s) =>
    s == "Sólida" ? line.style_solid : s == "Discontinua" ? line.style_dashed : line.style_dotted

f_delLine(id) =>
    if not na(id)
        line.delete(id)
f_delLbl(id) =>
    if not na(id)
        label.delete(id)

// ============================= DEFINICIÓN DEL DÍA (FUTUROS) =============================
// El oro en futuros (COMEX/GC) opera de 18:00 a 17:00 hora de Nueva York, con una pausa de
// mantenimiento de 17:00 a 18:00 ET. La mayoría de las herramientas de "niveles del día"
// (incluidas las academias que usan ese corte para el Máx/Mín/Cierre anterior y el pivote)
// arman el "día" con ese horario en vez de la medianoche del gráfico. Si tu feed ya respeta
// ese corte de forma nativa, podés desactivar esta opción y usar el día del gráfico.
grpFutDay     = "Definición del día (futuros)"
useFuturesDay = input.bool(true, "Definir el día como sesión de futuros (18:00-17:00 hora NY)", group=grpFutDay, tooltip="Recomendado para XAUUSD/GC en futuros (COMEX). Desactivalo si tu símbolo/feed ya define el día con ese mismo corte horario.")
futSession    = input.session("1800-1700", "Horario de la sesión de futuros (HHMM-HHMM)", group=grpFutDay)
futTimezone   = input.string("America/New_York", "Zona horaria de la sesión de futuros", group=grpFutDay)

inFutDay = not na(time(timeframe.period, futSession, futTimezone))
futDayId = year(time, futTimezone) * 10000 + month(time, futTimezone) * 100 + dayofmonth(time, futTimezone)

var float runFutHigh   = na
var float runFutLow    = na
var float runFutClose  = na
var float prevFutHigh  = na
var float prevFutLow   = na
var float prevFutClose = na
var float futDayOpen   = na
var bool  wasInFutDay  = false
var int   lastFutDay   = na

futStart = inFutDay and (not wasInFutDay or futDayId != lastFutDay)
futEnd   = wasInFutDay and not inFutDay

if futStart
    runFutHigh := high
    runFutLow  := low
    futDayOpen := open
    lastFutDay := futDayId
else if inFutDay
    runFutHigh := math.max(runFutHigh, high)
    runFutLow  := math.min(runFutLow, low)

if inFutDay
    runFutClose := close

if futEnd
    prevFutHigh  := runFutHigh
    prevFutLow   := runFutLow
    prevFutClose := runFutClose

wasInFutDay := inFutDay

// ============================= APERTURAS Y MÁX/MÍN ANTERIOR =============================
grpDW = "Día / Semana anterior"
showDOpen  = input.bool(false, "Apertura diaria", group=grpDW)
showWOpen  = input.bool(false, "Apertura semanal", group=grpDW)
showPDHL   = input.bool(true, "Máx/Mín día anterior (Res./Sop. mayor)", group=grpDW)
showPWHL   = input.bool(false, "Máx/Mín semana anterior", group=grpDW)
dOpenColor = input.color(color.new(color.gray, 0), "Color apertura diaria", group=grpDW)
wOpenColor = input.color(color.new(color.purple, 0), "Color apertura semanal", group=grpDW)
pdhColor   = input.color(color.new(color.red, 0), "Color Máx día anterior", group=grpDW)
pdlColor   = input.color(color.new(color.blue, 0), "Color Mín día anterior", group=grpDW)
pwhColor   = input.color(color.new(color.red, 55), "Color Máx semana anterior", group=grpDW)
pwlColor   = input.color(color.new(color.blue, 55), "Color Mín semana anterior", group=grpDW)
dwWidth    = input.int(1, "Grosor de línea", minval=1, maxval=4, group=grpDW)
dwStyleIn  = input.string("Discontinua", "Estilo apertura diaria/semanal", options=["Sólida", "Discontinua", "Punteada"], group=grpDW)
pdhlStyleIn= input.string("Sólida", "Estilo Máx/Mín anterior", options=["Sólida", "Discontinua", "Punteada"], group=grpDW)
showDWLabels = input.bool(true, "Mostrar etiquetas", group=grpDW)

dwLineStyle   = lineStyleFromInput(dwStyleIn)
pdhlLineStyle = lineStyleFromInput(pdhlStyleIn)

// Día anterior
// Si "useFuturesDay" está activo, la apertura se toma al empezar la sesión de futuros
// (18:00 NY) y el Máx/Mín/Cierre anterior al cerrarla (17:00 NY); si no, se usa el día
// tal como lo define el símbolo del gráfico (comportamiento anterior).
chartNewDayBar = ta.change(time("D")) != 0
chartPdHigh    = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
chartPdLow     = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
chartPdClose   = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)

dOpenTrigger = useFuturesDay ? futStart : chartNewDayBar
dOpenValue   = useFuturesDay ? futDayOpen : open
pdhlTrigger  = useFuturesDay ? futEnd : chartNewDayBar
pdHigh       = useFuturesDay ? prevFutHigh : chartPdHigh
pdLow        = useFuturesDay ? prevFutLow  : chartPdLow
pdClose      = useFuturesDay ? prevFutClose : chartPdClose

var line  dOpenLine = na
var label dOpenLbl  = na
var line  pdhLine = na
var line  pdlLine = na
var label pdhLbl  = na
var label pdlLbl  = na

if dOpenTrigger
    if showDOpen
        if not na(dOpenLine)
            line.delete(dOpenLine)
        if not na(dOpenLbl)
            label.delete(dOpenLbl)
        dOpenLine := line.new(bar_index, dOpenValue, bar_index, dOpenValue, color=dOpenColor, width=dwWidth, style=dwLineStyle)
        if showDWLabels
            dOpenLbl := label.new(bar_index, dOpenValue, "APERTURA DÍA", style=label.style_label_left, color=color.new(color.white, 100), textcolor=dOpenColor, size=size.tiny)

if pdhlTrigger
    if showPDHL and not na(pdHigh)
        if not na(pdhLine)
            line.delete(pdhLine)
        if not na(pdlLine)
            line.delete(pdlLine)
        if not na(pdhLbl)
            label.delete(pdhLbl)
        if not na(pdlLbl)
            label.delete(pdlLbl)
        pdhLine := line.new(bar_index, pdHigh, bar_index, pdHigh, color=pdhColor, width=dwWidth, style=pdhlLineStyle)
        pdlLine := line.new(bar_index, pdLow, bar_index, pdLow, color=pdlColor, width=dwWidth, style=pdhlLineStyle)
        if showDWLabels
            pdhLbl := label.new(bar_index, pdHigh, "RESISTENCIA MAYOR", style=label.style_label_left, color=color.new(color.white, 100), textcolor=pdhColor, size=size.tiny)
            pdlLbl := label.new(bar_index, pdLow, "SOPORTE MAYOR", style=label.style_label_left, color=color.new(color.white, 100), textcolor=pdlColor, size=size.tiny)

if not na(dOpenLine)
    line.set_x2(dOpenLine, bar_index)
    if not na(dOpenLbl)
        label.set_x(dOpenLbl, bar_index)
if not na(pdhLine)
    line.set_x2(pdhLine, bar_index)
    line.set_x2(pdlLine, bar_index)
    if not na(pdhLbl)
        label.set_x(pdhLbl, bar_index)
        label.set_x(pdlLbl, bar_index)

// ============================= NIVELES CAMARILLA DEL DÍA (DAY) =============================
// El "DAY" de FlowScanner no es el máx/mín del día en curso: es un soporte/resistencia
// AJUSTADO AL CIERRE anterior (no al rango completo como los pivotes clásicos), pensado
// para operar el rebote — si el precio rebota en un nivel, el objetivo es el siguiente
// nivel "DAY" hacia ese lado. Eso es exactamente el pivote Camarilla:
//   R4 = C + Rango*1.1/2   R3 = C + Rango*1.1/4   R2 = C + Rango*1.1/6   R1 = C + Rango*1.1/12
//   S1 = C - Rango*1.1/12  S2 = C - Rango*1.1/6   S3 = C - Rango*1.1/4  S4 = C - Rango*1.1/2
// donde Rango = Máx - Mín y C = Cierre, todos del día anterior (mismo criterio de "día"
// que el resto: futuros 18:00-17:00 NY si "useFuturesDay" está activo).
// R1/S1 (los más cercanos al cierre, los que más se tocan y rebotan durante el día) son
// el "DAY" que se ve en la imagen; R2-R4/S2-S4 quedan opcionales para no saturar el gráfico.
grpDay       = "Niveles Camarilla del día (DAY)"
showDay      = input.bool(true, "Mostrar DAY (Camarilla R1/S1)", group=grpDay)
showDayR2S2  = input.bool(false, "Mostrar también R2/S2", group=grpDay)
showDayR3S3  = input.bool(false, "Mostrar también R3/S3", group=grpDay)
showDayR4S4  = input.bool(false, "Mostrar también R4/S4 (extremos de reversión)", group=grpDay)
dayColor     = input.color(color.new(color.yellow, 0), "Color DAY (R1/S1)", group=grpDay)
dayOuterColor= input.color(color.new(color.yellow, 45), "Color R2-R4 / S2-S4", group=grpDay)
dayWidth     = input.int(2, "Grosor de línea", minval=1, maxval=4, group=grpDay)
dayStyleIn   = input.string("Sólida", "Estilo de línea", options=["Sólida", "Discontinua", "Punteada"], group=grpDay)
showDayLabels = input.bool(true, "Mostrar etiquetas", group=grpDay)
dayLineStyle = lineStyleFromInput(dayStyleIn)

camRange = pdHigh - pdLow
camR1 = pdClose + camRange * 1.1 / 12
camS1 = pdClose - camRange * 1.1 / 12
camR2 = pdClose + camRange * 1.1 / 6
camS2 = pdClose - camRange * 1.1 / 6
camR3 = pdClose + camRange * 1.1 / 4
camS3 = pdClose - camRange * 1.1 / 4
camR4 = pdClose + camRange * 1.1 / 2
camS4 = pdClose - camRange * 1.1 / 2

var line  dayR1Line = na
var line  dayS1Line = na
var line  dayR2Line = na
var line  dayS2Line = na
var line  dayR3Line = na
var line  dayS3Line = na
var line  dayR4Line = na
var line  dayS4Line = na
var label dayR1Lbl = na
var label dayS1Lbl = na
var label dayR2Lbl = na
var label dayS2Lbl = na
var label dayR3Lbl = na
var label dayS3Lbl = na
var label dayR4Lbl = na
var label dayS4Lbl = na

if pdhlTrigger and not na(pdClose)
    if showDay
        f_delLine(dayR1Line)
        f_delLine(dayS1Line)
        f_delLbl(dayR1Lbl)
        f_delLbl(dayS1Lbl)
        dayR1Line := line.new(bar_index, camR1, bar_index, camR1, color=dayColor, width=dayWidth, style=dayLineStyle)
        dayS1Line := line.new(bar_index, camS1, bar_index, camS1, color=dayColor, width=dayWidth, style=dayLineStyle)
        if showDayLabels
            dayR1Lbl := label.new(bar_index, camR1, "DAY", style=label.style_label_left, color=color.new(color.white, 100), textcolor=dayColor, size=size.tiny)
            dayS1Lbl := label.new(bar_index, camS1, "DAY", style=label.style_label_left, color=color.new(color.white, 100), textcolor=dayColor, size=size.tiny)
    if showDayR2S2
        f_delLine(dayR2Line)
        f_delLine(dayS2Line)
        f_delLbl(dayR2Lbl)
        f_delLbl(dayS2Lbl)
        dayR2Line := line.new(bar_index, camR2, bar_index, camR2, color=dayOuterColor, width=dayWidth, style=dayLineStyle)
        dayS2Line := line.new(bar_index, camS2, bar_index, camS2, color=dayOuterColor, width=dayWidth, style=dayLineStyle)
        if showDayLabels
            dayR2Lbl := label.new(bar_index, camR2, "DAY R2", style=label.style_label_left, color=color.new(color.white, 100), textcolor=dayOuterColor, size=size.tiny)
            dayS2Lbl := label.new(bar_index, camS2, "DAY S2", style=label.style_label_left, color=color.new(color.white, 100), textcolor=dayOuterColor, size=size.tiny)
    if showDayR3S3
        f_delLine(dayR3Line)
        f_delLine(dayS3Line)
        f_delLbl(dayR3Lbl)
        f_delLbl(dayS3Lbl)
        dayR3Line := line.new(bar_index, camR3, bar_index, camR3, color=dayOuterColor, width=dayWidth, style=dayLineStyle)
        dayS3Line := line.new(bar_index, camS3, bar_index, camS3, color=dayOuterColor, width=dayWidth, style=dayLineStyle)
        if showDayLabels
            dayR3Lbl := label.new(bar_index, camR3, "DAY R3", style=label.style_label_left, color=color.new(color.white, 100), textcolor=dayOuterColor, size=size.tiny)
            dayS3Lbl := label.new(bar_index, camS3, "DAY S3", style=label.style_label_left, color=color.new(color.white, 100), textcolor=dayOuterColor, size=size.tiny)
    if showDayR4S4
        f_delLine(dayR4Line)
        f_delLine(dayS4Line)
        f_delLbl(dayR4Lbl)
        f_delLbl(dayS4Lbl)
        dayR4Line := line.new(bar_index, camR4, bar_index, camR4, color=dayOuterColor, width=dayWidth, style=dayLineStyle)
        dayS4Line := line.new(bar_index, camS4, bar_index, camS4, color=dayOuterColor, width=dayWidth, style=dayLineStyle)
        if showDayLabels
            dayR4Lbl := label.new(bar_index, camR4, "DAY R4", style=label.style_label_left, color=color.new(color.white, 100), textcolor=dayOuterColor, size=size.tiny)
            dayS4Lbl := label.new(bar_index, camS4, "DAY S4", style=label.style_label_left, color=color.new(color.white, 100), textcolor=dayOuterColor, size=size.tiny)

if showDay and not na(dayR1Line)
    line.set_x2(dayR1Line, bar_index)
    line.set_x2(dayS1Line, bar_index)
    if not na(dayR1Lbl)
        label.set_x(dayR1Lbl, bar_index)
        label.set_x(dayS1Lbl, bar_index)
if showDayR2S2 and not na(dayR2Line)
    line.set_x2(dayR2Line, bar_index)
    line.set_x2(dayS2Line, bar_index)
    if not na(dayR2Lbl)
        label.set_x(dayR2Lbl, bar_index)
        label.set_x(dayS2Lbl, bar_index)
if showDayR3S3 and not na(dayR3Line)
    line.set_x2(dayR3Line, bar_index)
    line.set_x2(dayS3Line, bar_index)
    if not na(dayR3Lbl)
        label.set_x(dayR3Lbl, bar_index)
        label.set_x(dayS3Lbl, bar_index)
if showDayR4S4 and not na(dayR4Line)
    line.set_x2(dayR4Line, bar_index)
    line.set_x2(dayS4Line, bar_index)
    if not na(dayR4Lbl)
        label.set_x(dayR4Lbl, bar_index)
        label.set_x(dayS4Lbl, bar_index)

// Semana anterior
newWeekBar = ta.change(time("W")) != 0
pwHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwLow  = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_off)

var line  wOpenLine = na
var label wOpenLbl  = na
var line  pwhLine = na
var line  pwlLine = na
var label pwhLbl  = na
var label pwlLbl  = na

if newWeekBar
    if showWOpen
        if not na(wOpenLine)
            line.delete(wOpenLine)
        if not na(wOpenLbl)
            label.delete(wOpenLbl)
        wOpenLine := line.new(bar_index, open, bar_index, open, color=wOpenColor, width=dwWidth, style=dwLineStyle)
        if showDWLabels
            wOpenLbl := label.new(bar_index, open, "APERTURA SEMANA", style=label.style_label_left, color=color.new(color.white, 100), textcolor=wOpenColor, size=size.tiny)
    if showPWHL and not na(pwHigh)
        if not na(pwhLine)
            line.delete(pwhLine)
        if not na(pwlLine)
            line.delete(pwlLine)
        if not na(pwhLbl)
            label.delete(pwhLbl)
        if not na(pwlLbl)
            label.delete(pwlLbl)
        pwhLine := line.new(bar_index, pwHigh, bar_index, pwHigh, color=pwhColor, width=dwWidth, style=pdhlLineStyle)
        pwlLine := line.new(bar_index, pwLow, bar_index, pwLow, color=pwlColor, width=dwWidth, style=pdhlLineStyle)
        if showDWLabels
            pwhLbl := label.new(bar_index, pwHigh, "RESISTENCIA MAYOR SEMANAL", style=label.style_label_left, color=color.new(color.white, 100), textcolor=pwhColor, size=size.tiny)
            pwlLbl := label.new(bar_index, pwLow, "SOPORTE MAYOR SEMANAL", style=label.style_label_left, color=color.new(color.white, 100), textcolor=pwlColor, size=size.tiny)

if not na(wOpenLine)
    line.set_x2(wOpenLine, bar_index)
    if not na(wOpenLbl)
        label.set_x(wOpenLbl, bar_index)
if not na(pwhLine)
    line.set_x2(pwhLine, bar_index)
    line.set_x2(pwlLine, bar_index)
    if not na(pwhLbl)
        label.set_x(pwhLbl, bar_index)
        label.set_x(pwlLbl, bar_index)

// ============================= SESIÓN DE ASIA (TOKIO) =============================
grpAsia = "Sesión de Asia"
showAsiaHl   = input.bool(false, "Mostrar Alto/Bajo de la sesión de Asia anterior", group=grpAsia)
asiaSession  = input.session("0000-0900", "Horario sesión Asia (HHMM-HHMM)", group=grpAsia, tooltip="Por defecto: 00:00-09:00 hora de Tokio (aprox. sesión asiática/Tokio).")
asiaTimezone = "Asia/Tokyo"
asiaHighColor= input.color(color.new(color.orange, 0), "Color alto sesión Asia", group=grpAsia)
asiaLowColor = input.color(color.new(color.teal, 0), "Color bajo sesión Asia", group=grpAsia)
asiaWidth    = input.int(1, "Grosor de línea", minval=1, maxval=4, group=grpAsia)
asiaStyleIn  = input.string("Discontinua", "Estilo de línea", options=["Sólida", "Discontinua", "Punteada"], group=grpAsia)
showAsiaLabels = input.bool(true, "Mostrar etiquetas", group=grpAsia)
asiaLineStyle = lineStyleFromInput(asiaStyleIn)

inAsia = not na(time(timeframe.period, asiaSession, asiaTimezone))
asiaDayId = year(time, asiaTimezone) * 10000 + month(time, asiaTimezone) * 100 + dayofmonth(time, asiaTimezone)

var float runAsiaHigh   = na
var float runAsiaLow    = na
var float runAsiaClose  = na
var float prevAsiaHigh  = na
var float prevAsiaLow   = na
var float prevAsiaClose = na
var bool  wasInAsia     = false
var int   lastAsiaDay   = na

// El chequeo de cambio de día calendario (además del propio corte de sesión) evita que,
// si la sesión no cierra bien por datos overnight, se arrastre el rango de varios días juntos.
asiaStart = inAsia and (not wasInAsia or asiaDayId != lastAsiaDay)
asiaEnd   = wasInAsia and not inAsia

if asiaStart
    runAsiaHigh := high
    runAsiaLow  := low
    lastAsiaDay := asiaDayId
else if inAsia
    runAsiaHigh := math.max(runAsiaHigh, high)
    runAsiaLow  := math.min(runAsiaLow, low)

if inAsia
    runAsiaClose := close

if asiaEnd
    prevAsiaHigh  := runAsiaHigh
    prevAsiaLow   := runAsiaLow
    prevAsiaClose := runAsiaClose

wasInAsia := inAsia

var line  asiaHLine = na
var line  asiaLLine = na
var label asiaHLbl  = na
var label asiaLLbl  = na

if showAsiaHl and asiaEnd and not na(prevAsiaHigh)
    if not na(asiaHLine)
        line.delete(asiaHLine)
    if not na(asiaLLine)
        line.delete(asiaLLine)
    if not na(asiaHLbl)
        label.delete(asiaHLbl)
    if not na(asiaLLbl)
        label.delete(asiaLLbl)
    asiaHLine := line.new(bar_index, prevAsiaHigh, bar_index, prevAsiaHigh, color=asiaHighColor, width=asiaWidth, style=asiaLineStyle)
    asiaLLine := line.new(bar_index, prevAsiaLow, bar_index, prevAsiaLow, color=asiaLowColor, width=asiaWidth, style=asiaLineStyle)
    if showAsiaLabels
        asiaHLbl := label.new(bar_index, prevAsiaHigh, "RESISTENCIA ASIA", style=label.style_label_left, color=color.new(color.white, 100), textcolor=asiaHighColor, size=size.tiny)
        asiaLLbl := label.new(bar_index, prevAsiaLow, "SOPORTE ASIA", style=label.style_label_left, color=color.new(color.white, 100), textcolor=asiaLowColor, size=size.tiny)

if showAsiaHl and not na(asiaHLine)
    line.set_x2(asiaHLine, bar_index)
    line.set_x2(asiaLLine, bar_index)
    if not na(asiaHLbl)
        label.set_x(asiaHLbl, bar_index)
        label.set_x(asiaLLbl, bar_index)

// ============================= SESIÓN DE LONDRES ("nivel de Londres") =============================
grpLdn = "Sesión de Londres"
showLdnHl    = input.bool(false, "Mostrar Alto/Bajo de la sesión de Londres anterior", group=grpLdn)
showLdnOpen  = input.bool(false, "Mostrar apertura de Londres", group=grpLdn)
ldnSession   = input.session("0800-1630", "Horario sesión Londres (HHMM-HHMM)", group=grpLdn, tooltip="Por defecto: horario regular del London Stock Exchange (08:00-16:30 hora de Londres).")
ldnTimezone  = "Europe/London"
ldnHighColor = input.color(color.new(color.purple, 0), "Color alto sesión Londres", group=grpLdn)
ldnLowColor  = input.color(color.new(color.maroon, 0), "Color bajo sesión Londres", group=grpLdn)
ldnOpenColor = input.color(color.new(color.fuchsia, 0), "Color apertura de Londres", group=grpLdn)
ldnWidth     = input.int(1, "Grosor de línea", minval=1, maxval=4, group=grpLdn)
ldnStyleIn   = input.string("Discontinua", "Estilo de línea", options=["Sólida", "Discontinua", "Punteada"], group=grpLdn)
showLdnLabels = input.bool(true, "Mostrar etiquetas", group=grpLdn)
ldnLineStyle = lineStyleFromInput(ldnStyleIn)

inLdn = not na(time(timeframe.period, ldnSession, ldnTimezone))
ldnDayId = year(time, ldnTimezone) * 10000 + month(time, ldnTimezone) * 100 + dayofmonth(time, ldnTimezone)

var float runLdnHigh   = na
var float runLdnLow    = na
var float runLdnClose  = na
var float prevLdnHigh  = na
var float prevLdnLow   = na
var float prevLdnClose = na
var bool  wasInLdn     = false
var int   lastLdnDay   = na

ldnStart = inLdn and (not wasInLdn or ldnDayId != lastLdnDay)
ldnEnd   = wasInLdn and not inLdn

if ldnStart
    runLdnHigh := high
    runLdnLow  := low
    lastLdnDay := ldnDayId
else if inLdn
    runLdnHigh := math.max(runLdnHigh, high)
    runLdnLow  := math.min(runLdnLow, low)

if inLdn
    runLdnClose := close

if ldnEnd
    prevLdnHigh  := runLdnHigh
    prevLdnLow   := runLdnLow
    prevLdnClose := runLdnClose

var float ldnOpenVal = na
var line  ldnOpenLine = na
var label ldnOpenLbl  = na

if ldnStart
    ldnOpenVal := open
    if showLdnOpen
        if not na(ldnOpenLine)
            line.delete(ldnOpenLine)
        if not na(ldnOpenLbl)
            label.delete(ldnOpenLbl)
        ldnOpenLine := line.new(bar_index, ldnOpenVal, bar_index, ldnOpenVal, color=ldnOpenColor, width=ldnWidth, style=ldnLineStyle)
        if showLdnLabels
            ldnOpenLbl := label.new(bar_index, ldnOpenVal, "APERTURA LONDRES", style=label.style_label_left, color=color.new(color.white, 100), textcolor=ldnOpenColor, size=size.tiny)

if showLdnOpen and not na(ldnOpenLine)
    line.set_x2(ldnOpenLine, bar_index)
    if not na(ldnOpenLbl)
        label.set_x(ldnOpenLbl, bar_index)

wasInLdn := inLdn

var line  ldnHLine = na
var line  ldnLLine = na
var label ldnHLbl  = na
var label ldnLLbl  = na

if showLdnHl and ldnEnd and not na(prevLdnHigh)
    if not na(ldnHLine)
        line.delete(ldnHLine)
    if not na(ldnLLine)
        line.delete(ldnLLine)
    if not na(ldnHLbl)
        label.delete(ldnHLbl)
    if not na(ldnLLbl)
        label.delete(ldnLLbl)
    ldnHLine := line.new(bar_index, prevLdnHigh, bar_index, prevLdnHigh, color=ldnHighColor, width=ldnWidth, style=ldnLineStyle)
    ldnLLine := line.new(bar_index, prevLdnLow, bar_index, prevLdnLow, color=ldnLowColor, width=ldnWidth, style=ldnLineStyle)
    if showLdnLabels
        ldnHLbl := label.new(bar_index, prevLdnHigh, "RESISTENCIA LONDRES", style=label.style_label_left, color=color.new(color.white, 100), textcolor=ldnHighColor, size=size.tiny)
        ldnLLbl := label.new(bar_index, prevLdnLow, "SOPORTE LONDRES", style=label.style_label_left, color=color.new(color.white, 100), textcolor=ldnLowColor, size=size.tiny)

if showLdnHl and not na(ldnHLine)
    line.set_x2(ldnHLine, bar_index)
    line.set_x2(ldnLLine, bar_index)
    if not na(ldnHLbl)
        label.set_x(ldnHLbl, bar_index)
        label.set_x(ldnLLbl, bar_index)

// ============================= APERTURA NUEVA YORK Y MEDIANOCHE (ICT) =============================
grpNY = "Nueva York"
showNYOpen  = input.bool(false, "Mostrar apertura de Nueva York (sesión regular)", group=grpNY)
nySession   = input.session("0930-1600", "Horario sesión NY (HHMM-HHMM)", group=grpNY, tooltip="Por defecto: horario regular del mercado de EE.UU. (09:30-16:00 hora de Nueva York).")
nyTimezone  = "America/New_York"
nyOpenColor = input.color(color.new(color.lime, 0), "Color apertura NY", group=grpNY)
showMidnight    = input.bool(false, "Mostrar apertura medianoche NY (00:00, estilo ICT)", group=grpNY)
midnightColor   = input.color(color.new(color.yellow, 0), "Color apertura medianoche", group=grpNY)
nyWidth     = input.int(1, "Grosor de línea", minval=1, maxval=4, group=grpNY)
nyStyleIn   = input.string("Punteada", "Estilo de línea", options=["Sólida", "Discontinua", "Punteada"], group=grpNY)
showNYLabels = input.bool(true, "Mostrar etiquetas", group=grpNY)
nyLineStyle = lineStyleFromInput(nyStyleIn)

inNY = not na(time(timeframe.period, nySession, nyTimezone))
nyDayId = year(time, nyTimezone) * 10000 + month(time, nyTimezone) * 100 + dayofmonth(time, nyTimezone)

var float runNYHigh   = na
var float runNYLow    = na
var float runNYClose  = na
var float prevNYHigh  = na
var float prevNYLow   = na
var float prevNYClose = na
var bool  wasInNY      = false
var int   lastNYDay    = na

nyStart = inNY and (not wasInNY or nyDayId != lastNYDay)
nyEnd   = wasInNY and not inNY

if nyStart
    runNYHigh := high
    runNYLow  := low
    lastNYDay := nyDayId
else if inNY
    runNYHigh := math.max(runNYHigh, high)
    runNYLow  := math.min(runNYLow, low)

if inNY
    runNYClose := close

if nyEnd
    prevNYHigh  := runNYHigh
    prevNYLow   := runNYLow
    prevNYClose := runNYClose

wasInNY := inNY

var line  nyOpenLine = na
var label nyOpenLbl  = na

if nyStart
    if showNYOpen
        if not na(nyOpenLine)
            line.delete(nyOpenLine)
        if not na(nyOpenLbl)
            label.delete(nyOpenLbl)
        nyOpenLine := line.new(bar_index, open, bar_index, open, color=nyOpenColor, width=nyWidth, style=nyLineStyle)
        if showNYLabels
            nyOpenLbl := label.new(bar_index, open, "APERTURA NY", style=label.style_label_left, color=color.new(color.white, 100), textcolor=nyOpenColor, size=size.tiny)

if showNYOpen and not na(nyOpenLine)
    line.set_x2(nyOpenLine, bar_index)
    if not na(nyOpenLbl)
        label.set_x(nyOpenLbl, bar_index)

midnightBar = ta.change(time("D", nyTimezone)) != 0

var line  midnightLine = na
var label midnightLbl  = na

if midnightBar
    if showMidnight
        if not na(midnightLine)
            line.delete(midnightLine)
        if not na(midnightLbl)
            label.delete(midnightLbl)
        midnightLine := line.new(bar_index, open, bar_index, open, color=midnightColor, width=nyWidth, style=nyLineStyle)
        if showNYLabels
            midnightLbl := label.new(bar_index, open, "MEDIANOCHE NY", style=label.style_label_left, color=color.new(color.white, 100), textcolor=midnightColor, size=size.tiny)

if showMidnight and not na(midnightLine)
    line.set_x2(midnightLine, bar_index)
    if not na(midnightLbl)
        label.set_x(midnightLbl, bar_index)

// ============================= PIVOTES CLÁSICOS (FLOOR TRADER) =============================
grpPiv = "Pivotes"
showPivots  = input.bool(true, "Mostrar pivotes clásicos", group=grpPiv)
pivotTfIn   = input.string("Diario", "Timeframe de los pivotes", options=["Diario", "Semanal", "Mensual"], group=grpPiv)
showR2S2    = input.bool(false, "Mostrar R2/S2", group=grpPiv)
showR3S3    = input.bool(false, "Mostrar R3/S3", group=grpPiv)
ppColor = input.color(color.new(color.gray, 0), "Color PP (pivote central)", group=grpPiv)
rColor  = input.color(color.new(color.red, 0), "Color resistencias (R1-R3)", group=grpPiv)
sColor  = input.color(color.new(color.green, 0), "Color soportes (S1-S3)", group=grpPiv)
pivWidth   = input.int(1, "Grosor de línea", minval=1, maxval=4, group=grpPiv)
pivStyleIn = input.string("Sólida", "Estilo de línea", options=["Sólida", "Discontinua", "Punteada"], group=grpPiv)
showPivLabels = input.bool(true, "Mostrar etiquetas", group=grpPiv)
pivLineStyle = lineStyleFromInput(pivStyleIn)

pivotTf = pivotTfIn == "Semanal" ? "W" : pivotTfIn == "Mensual" ? "M" : "D"
useFuturesDayForPivot = pivotTfIn == "Diario" and useFuturesDay

[secPivH, secPivL, secPivC] = request.security(syminfo.tickerid, pivotTf, [high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)
secNewPivotBar = ta.change(time(pivotTf)) != 0

// En diario, si el corte de día es el de futuros (18:00-17:00 NY), el Máx/Mín/Cierre del
// pivote sale de esa sesión en vez del día que define el gráfico (mismo criterio que PDH/PDL).
pivH = useFuturesDayForPivot ? prevFutHigh  : secPivH
pivL = useFuturesDayForPivot ? prevFutLow   : secPivL
pivC = useFuturesDayForPivot ? prevFutClose : secPivC
newPivotBar = useFuturesDayForPivot ? futEnd : secNewPivotBar

pp = (pivH + pivL + pivC) / 3
r1 = 2 * pp - pivL
s1 = 2 * pp - pivH
r2 = pp + (pivH - pivL)
s2 = pp - (pivH - pivL)
r3 = pivH + 2 * (pp - pivL)
s3 = pivL - 2 * (pivH - pp)

var line  ppLine = na
var line  r1Line = na
var line  r2Line = na
var line  r3Line = na
var line  s1Line = na
var line  s2Line = na
var line  s3Line = na
var label ppLbl = na
var label r1Lbl = na
var label r2Lbl = na
var label r3Lbl = na
var label s1Lbl = na
var label s2Lbl = na
var label s3Lbl = na

if showPivots and newPivotBar and not na(pp)
    f_delLine(ppLine)
    f_delLine(r1Line)
    f_delLine(r2Line)
    f_delLine(r3Line)
    f_delLine(s1Line)
    f_delLine(s2Line)
    f_delLine(s3Line)
    f_delLbl(ppLbl)
    f_delLbl(r1Lbl)
    f_delLbl(r2Lbl)
    f_delLbl(r3Lbl)
    f_delLbl(s1Lbl)
    f_delLbl(s2Lbl)
    f_delLbl(s3Lbl)

    ppLine := line.new(bar_index, pp, bar_index, pp, color=ppColor, width=pivWidth, style=pivLineStyle)
    r1Line := line.new(bar_index, r1, bar_index, r1, color=color.new(rColor, 40), width=pivWidth, style=pivLineStyle)
    s1Line := line.new(bar_index, s1, bar_index, s1, color=color.new(sColor, 40), width=pivWidth, style=pivLineStyle)
    if showR2S2
        r2Line := line.new(bar_index, r2, bar_index, r2, color=color.new(rColor, 20), width=pivWidth, style=pivLineStyle)
        s2Line := line.new(bar_index, s2, bar_index, s2, color=color.new(sColor, 20), width=pivWidth, style=pivLineStyle)
    if showR3S3
        r3Line := line.new(bar_index, r3, bar_index, r3, color=color.new(rColor, 0), width=pivWidth, style=pivLineStyle)
        s3Line := line.new(bar_index, s3, bar_index, s3, color=color.new(sColor, 0), width=pivWidth, style=pivLineStyle)

    if showPivLabels
        ppLbl := label.new(bar_index, pp, "PIVOT CENTRAL", style=label.style_label_left, color=color.new(color.white, 100), textcolor=ppColor, size=size.tiny)
        r1Lbl := label.new(bar_index, r1, "RESISTENCIA", style=label.style_label_left, color=color.new(color.white, 100), textcolor=rColor, size=size.tiny)
        s1Lbl := label.new(bar_index, s1, "SOPORTE", style=label.style_label_left, color=color.new(color.white, 100), textcolor=sColor, size=size.tiny)
        if showR2S2
            r2Lbl := label.new(bar_index, r2, "RESISTENCIA 2", style=label.style_label_left, color=color.new(color.white, 100), textcolor=rColor, size=size.tiny)
            s2Lbl := label.new(bar_index, s2, "SOPORTE 2", style=label.style_label_left, color=color.new(color.white, 100), textcolor=sColor, size=size.tiny)
        if showR3S3
            r3Lbl := label.new(bar_index, r3, "RESISTENCIA 3", style=label.style_label_left, color=color.new(color.white, 100), textcolor=rColor, size=size.tiny)
            s3Lbl := label.new(bar_index, s3, "SOPORTE 3", style=label.style_label_left, color=color.new(color.white, 100), textcolor=sColor, size=size.tiny)

if showPivots and not na(ppLine)
    line.set_x2(ppLine, bar_index)
    line.set_x2(r1Line, bar_index)
    line.set_x2(s1Line, bar_index)
    if not na(ppLbl)
        label.set_x(ppLbl, bar_index)
        label.set_x(r1Lbl, bar_index)
        label.set_x(s1Lbl, bar_index)
    if showR2S2 and not na(r2Line)
        line.set_x2(r2Line, bar_index)
        line.set_x2(s2Line, bar_index)
        if not na(r2Lbl)
            label.set_x(r2Lbl, bar_index)
            label.set_x(s2Lbl, bar_index)
    if showR3S3 and not na(r3Line)
        line.set_x2(r3Line, bar_index)
        line.set_x2(s3Line, bar_index)
        if not na(r3Lbl)
            label.set_x(r3Lbl, bar_index)
            label.set_x(s3Lbl, bar_index)

// ============================= PIVOTES DE SESIÓN (ASIA / LONDRES / NUEVA YORK) =============================
// Mismo pivote clásico (PP/R1-R3/S1-S3) que el bloque anterior, pero calculado con el
// Alto/Bajo/Cierre de cada sesión (no del día completo) — el "Pivot Londres" que se ve en
// herramientas como FlowScanner es este mismo criterio aplicado a la sesión de Londres.
// Reutiliza grosor, estilo, etiquetas y colores de R/S del bloque de Pivotes de arriba;
// cada sesión solo define su propio color de PP para poder distinguirlas entre sí.
grpSessPiv = "Pivotes de sesión (Asia/Londres/NY)"
showAsiaPivot = input.bool(false, "Mostrar pivote de sesión Asia", group=grpSessPiv)
asiaPivColor  = input.color(color.new(color.orange, 0), "Color PP Asia", group=grpSessPiv)
showLdnPivot  = input.bool(true, "Mostrar pivote de sesión Londres", group=grpSessPiv)
ldnPivColor   = input.color(color.new(color.fuchsia, 0), "Color PP Londres", group=grpSessPiv)
showNYPivot   = input.bool(false, "Mostrar pivote de sesión Nueva York", group=grpSessPiv)
nyPivColor    = input.color(color.new(color.lime, 0), "Color PP Nueva York", group=grpSessPiv)

type PivSet
    line  ppLine
    line  r1Line
    line  r2Line
    line  r3Line
    line  s1Line
    line  s2Line
    line  s3Line
    label ppLbl
    label r1Lbl
    label r2Lbl
    label r3Lbl
    label s1Lbl
    label s2Lbl
    label s3Lbl

f_drawPivotSet(ps, h, l, c, trigger, tag, ppCol, rCol, sCol, w, styleIn, showLbl, showR2S2In, showR3S3In) =>
    if trigger and not na(h) and not na(l) and not na(c)
        sPP = (h + l + c) / 3
        sR1 = 2 * sPP - l
        sS1 = 2 * sPP - h
        sR2 = sPP + (h - l)
        sS2 = sPP - (h - l)
        sR3 = h + 2 * (sPP - l)
        sS3 = l - 2 * (h - sPP)

        f_delLine(ps.ppLine)
        f_delLine(ps.r1Line)
        f_delLine(ps.r2Line)
        f_delLine(ps.r3Line)
        f_delLine(ps.s1Line)
        f_delLine(ps.s2Line)
        f_delLine(ps.s3Line)
        f_delLbl(ps.ppLbl)
        f_delLbl(ps.r1Lbl)
        f_delLbl(ps.r2Lbl)
        f_delLbl(ps.r3Lbl)
        f_delLbl(ps.s1Lbl)
        f_delLbl(ps.s2Lbl)
        f_delLbl(ps.s3Lbl)

        ps.ppLine := line.new(bar_index, sPP, bar_index, sPP, color=ppCol, width=w, style=styleIn)
        ps.r1Line := line.new(bar_index, sR1, bar_index, sR1, color=color.new(rCol, 40), width=w, style=styleIn)
        ps.s1Line := line.new(bar_index, sS1, bar_index, sS1, color=color.new(sCol, 40), width=w, style=styleIn)
        if showR2S2In
            ps.r2Line := line.new(bar_index, sR2, bar_index, sR2, color=color.new(rCol, 20), width=w, style=styleIn)
            ps.s2Line := line.new(bar_index, sS2, bar_index, sS2, color=color.new(sCol, 20), width=w, style=styleIn)
        if showR3S3In
            ps.r3Line := line.new(bar_index, sR3, bar_index, sR3, color=color.new(rCol, 0), width=w, style=styleIn)
            ps.s3Line := line.new(bar_index, sS3, bar_index, sS3, color=color.new(sCol, 0), width=w, style=styleIn)

        if showLbl
            ps.ppLbl := label.new(bar_index, sPP, "PIVOT " + tag, style=label.style_label_left, color=color.new(color.white, 100), textcolor=ppCol, size=size.tiny)
            ps.r1Lbl := label.new(bar_index, sR1, "RESISTENCIA " + tag, style=label.style_label_left, color=color.new(color.white, 100), textcolor=rCol, size=size.tiny)
            ps.s1Lbl := label.new(bar_index, sS1, "SOPORTE " + tag, style=label.style_label_left, color=color.new(color.white, 100), textcolor=sCol, size=size.tiny)
            if showR2S2In
                ps.r2Lbl := label.new(bar_index, sR2, "RESISTENCIA 2 " + tag, style=label.style_label_left, color=color.new(color.white, 100), textcolor=rCol, size=size.tiny)
                ps.s2Lbl := label.new(bar_index, sS2, "SOPORTE 2 " + tag, style=label.style_label_left, color=color.new(color.white, 100), textcolor=sCol, size=size.tiny)
            if showR3S3In
                ps.r3Lbl := label.new(bar_index, sR3, "RESISTENCIA 3 " + tag, style=label.style_label_left, color=color.new(color.white, 100), textcolor=rCol, size=size.tiny)
                ps.s3Lbl := label.new(bar_index, sS3, "SOPORTE 3 " + tag, style=label.style_label_left, color=color.new(color.white, 100), textcolor=sCol, size=size.tiny)

    if not na(ps.ppLine)
        line.set_x2(ps.ppLine, bar_index)
        line.set_x2(ps.r1Line, bar_index)
        line.set_x2(ps.s1Line, bar_index)
        if not na(ps.ppLbl)
            label.set_x(ps.ppLbl, bar_index)
            label.set_x(ps.r1Lbl, bar_index)
            label.set_x(ps.s1Lbl, bar_index)
        if showR2S2In and not na(ps.r2Line)
            line.set_x2(ps.r2Line, bar_index)
            line.set_x2(ps.s2Line, bar_index)
            if not na(ps.r2Lbl)
                label.set_x(ps.r2Lbl, bar_index)
                label.set_x(ps.s2Lbl, bar_index)
        if showR3S3In and not na(ps.r3Line)
            line.set_x2(ps.r3Line, bar_index)
            line.set_x2(ps.s3Line, bar_index)
            if not na(ps.r3Lbl)
                label.set_x(ps.r3Lbl, bar_index)
                label.set_x(ps.s3Lbl, bar_index)
    ps

var PivSet asiaPivSet = PivSet.new()
var PivSet ldnPivSet  = PivSet.new()
var PivSet nyPivSet   = PivSet.new()

if showAsiaPivot
    asiaPivSet := f_drawPivotSet(asiaPivSet, prevAsiaHigh, prevAsiaLow, prevAsiaClose, asiaEnd, "ASIA", asiaPivColor, rColor, sColor, pivWidth, pivLineStyle, showPivLabels, showR2S2, showR3S3)
if showLdnPivot
    ldnPivSet := f_drawPivotSet(ldnPivSet, prevLdnHigh, prevLdnLow, prevLdnClose, ldnEnd, "LONDRES", ldnPivColor, rColor, sColor, pivWidth, pivLineStyle, showPivLabels, showR2S2, showR3S3)
if showNYPivot
    nyPivSet := f_drawPivotSet(nyPivSet, prevNYHigh, prevNYLow, prevNYClose, nyEnd, "NY", nyPivColor, rColor, sColor, pivWidth, pivLineStyle, showPivLabels, showR2S2, showR3S3)

// ============================= ALERTAS =============================
grpAlert = "Alertas"
alertPDH = input.bool(false, "Alertar ruptura de Res. Mayor (día anterior)", group=grpAlert)
alertPDL = input.bool(false, "Alertar ruptura de Sop. Mayor (día anterior)", group=grpAlert)
alertPivPP = input.bool(false, "Alertar cruce del Pivote Central (PP)", group=grpAlert)
alertLdnH = input.bool(false, "Alertar ruptura del Máx de Londres", group=grpAlert)
alertLdnL = input.bool(false, "Alertar ruptura del Mín de Londres", group=grpAlert)

alertcondition(alertPDH and not na(pdHigh) and ta.crossover(close, pdHigh), title="Ruptura Res. Mayor (día ant.)", message="{{ticker}}: cierre por encima del máximo del día anterior")
alertcondition(alertPDL and not na(pdLow) and ta.crossunder(close, pdLow), title="Ruptura Sop. Mayor (día ant.)", message="{{ticker}}: cierre por debajo del mínimo del día anterior")
alertcondition(alertPivPP and not na(pp) and ta.cross(close, pp), title="Cruce del Pivote Central", message="{{ticker}}: cruce del pivote central (PP)")
alertcondition(alertLdnH and not na(prevLdnHigh) and ta.crossover(close, prevLdnHigh), title="Ruptura Máx Londres", message="{{ticker}}: cierre por encima del máximo de la sesión de Londres")
alertcondition(alertLdnL and not na(prevLdnLow) and ta.crossunder(close, prevLdnLow), title="Ruptura Mín Londres", message="{{ticker}}: cierre por debajo del mínimo de la sesión de Londres")
